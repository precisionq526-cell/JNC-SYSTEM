# Copy to .env.local on the shop server. Never commit real keys or proofs.
NEXT_PUBLIC_APP_NAME=JandC Internet Cafe and Services
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3100
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=public-anon-placeholder-replace-before-use
SUPABASE_SERVICE_ROLE_KEY=server-only-placeholder-replace-before-use

# Persistent folders must be writable by the Windows account running the app.
KIOSK_LOCAL_PATH=C:\KioskFiles
KIOSK_RUNTIME_PATH=C:\KioskFiles\.runtime
KIOSK_STATION_ID=
KIOSK_LOCATION=
KIOSK_DEVICE_TOKEN=

# Optional LAN/mobile bridge configuration. Leave blank for local-only use.
NEXT_PUBLIC_LAN_IP=
KIOSK_APP_URL=http://127.0.0.1:3100
KIOSK_SYNC_INTERVAL_MS=15000
HARDWARE_BRIDGE_INTERVAL_MS=15000

# Optional override; blank uses the bundled portable print engine.
SUMATRA_PDF_PATH=

# Configure only verified shop accounts. Blank leaves online wallets disabled.
PAYMENT_GCASH_NAME=
PAYMENT_GCASH_NUMBER=
PAYMENT_MAYA_NAME=
PAYMENT_MAYA_NUMBER=

